{% extends 'base.html.twig' %}

{% block title %}Lab Locations{% endblock %}

{% block body %}
<div class="admin-page">
    <div class="admin-container">

        <!-- Page Header -->
        <div class="admin-header-center">
            <div>
                <h1 class="admin-title-lg">Lab Locations</h1>
                <p class="admin-subtitle-lg-text">Manage all SYNCRO LAB branches.</p>
            </div>
            <a href="{{ path('admin_locations_add') }}" class="btn btn--green btn-header-xl">
                + ADD LOCATION
            </a>
        </div>

        <!-- Locations Table -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="admin-table location-table" style="min-width: 600px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th class="center">Status</th>
                            <th class="center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for location in locations %}
                            <tr>
                                <!-- Name & Phone -->
                                <td>
                                    <strong>{{ location.name }}</strong>
                                    <br>
                                    <span class="text-muted">
                                        {{ location.phone ? location.phone : 'No phone' }}
                                    </span>
                                </td>

                                <!-- Address -->
                                <td class="address-cell">
                                    {{ location.address }}
                                </td>

                                <!-- Status -->
                                <td class="center">
                                    <span class="status-badge {{ location.is_active ? 'active' : 'inactive' }}">
                                        {{ location.is_active ? 'Active' : 'Inactive' }}
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="center">
                                    <div class="action-buttons">
                                        <a href="{{ path('admin_locations_edit', {'id': location.id}) }}" class="btn-edit">Edit</a>
                                        <a href="#" class="btn-delete" onclick="return confirm('Are you sure you want to delete this location? This will also remove any associated inventory.');">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <p class="admin-total-text">
            Total locations: {{ totalLocations }}
        </p>

        <p class="mt-32">
            <a href="{{ path('admin_dashboard') }}" class="text-green text-bold no-underline">&larr; Back to Dashboard</a>
        </p>

    </div>
</div>
{% endblock %}