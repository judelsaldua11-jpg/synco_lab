{% extends 'base.html.twig' %}

{% block title %}Add New Product{% endblock %}

{% block body %}
<div class="admin-page">
    <div class="admin-container-sm">
        
        <h1 class="admin-title-sm">
            Add New Product
        </h1>
        <p class="admin-subtitle-lg">
            Create a new product for the catalog.
        </p>

        <form method="POST" action="#" enctype="multipart/form-data" class="admin-form-card">
            
            <div class="form-grid">
                
                <div class="form-group">
                    <label for="name" class="form-label">Product Name *</label>
                    <input type="text" id="name" name="name" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="sku" class="form-label">SKU *</label>
                    <input type="text" id="sku" name="sku" required class="form-input">
                    <p class="form-help">Unique product identifier (e.g., SHIM-DA-9200)</p>
                </div>

                <div class="form-group">
                    <label for="brand" class="form-label">Brand</label>
                    <input type="text" id="brand" name="brand" class="form-input">
                </div>

                <div class="form-group">
                    <label for="price" class="form-label">Price *</label>
                    <input type="number" id="price" name="price" step="0.01" min="0.01" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="description" rows="4" class="form-textarea"></textarea>
                </div>

                <div class="form-group">
                    <label for="product_image" class="form-label">Product Image</label>
                    <input type="file" id="product_image" name="product_image" accept="image/jpeg,image/png,image/webp,image/gif" class="form-file">
                    <p class="form-help">Supported: JPG, PNG, WebP, GIF (max 5MB)</p>
                </div>

                <!-- CATEGORY PICKER -->
                <div class="category-picker" id="category-picker">
                    <label class="cat-picker-label">Categories</label>
                    
                    <div class="cat-picker-row">
                        <input type="search" id="cat-search" placeholder="Search categories..." autocomplete="off" class="cat-picker-search">
                        <input type="text" id="cat-new-input" placeholder="New category" autocomplete="off" class="cat-picker-new-input">
                        <button type="button" id="cat-add-btn" class="btn btn--outline cat-picker-add-btn">ADD</button>
                    </div>
                    
                    <div class="cat-picker-chips" id="cat-selected"></div>
                    <div id="cat-new-values"></div>
                    
                    <div class="cat-picker-options" id="cat-options">
                        {% for category in categories %}
                            <label class="cat-picker-option" data-category-name="{{ category.name|lower }}">
                                <input type="checkbox" name="categories[]" value="{{ category.id }}">
                                <span>{{ category.name }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="form-group mt-10">
                    <label class="form-checkbox-wrap">
                        <input type="checkbox" name="is_featured" value="1">
                        Show on homepage (Featured Hardware)
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn--green btn-form-submit">
                        ADD PRODUCT
                    </button>
                    <a href="{{ path('admin_products') }}" class="btn btn--outline btn-form-submit">
                        CANCEL
                    </a>
                </div>
                
            </div>
        </form>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<!-- Load the external JS file for this specific page -->
<script src="{{ asset('category-picker.js') }}"></script>
{% endblock %}