{% extends 'base.html.twig' %}

{% block title %}Product Management{% endblock %}

{% block body %}
<div class="admin-page">
    <div class="admin-container">

        <!-- Page Header -->
        <div class="admin-header-center">
            <div>
                <h1 class="admin-title" style="font-size: 48px; margin-bottom: 8px;">Product Management</h1>
                <p class="admin-subtitle" style="font-size: 18px;">Manage products and featured items on the homepage.</p>
            </div>
            <a href="{{ path('admin_products_add') }}" class="btn btn--green" style="height: 48px; font-size: 16px; padding: 0 24px;">
                + ADD NEW PRODUCT
            </a>
        </div>

        <!-- Products Table -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="admin-table product-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product</th>
                            <th>SKU</th>
                            <th class="center">Stock</th>
                            <th class="center">Featured</th>
                            <th class="center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr>
                                <td class="img-cell">
                                    {% if product.image %}
                                        <img src="{{ asset(product.image) }}" alt="{{ product.name }}" class="product-img">
                                    {% else %}
                                        <img src="{{ asset('images/SL.svg') }}" alt="{{ product.name }}" class="product-img">
                                    {% endif %}
                                </td>

                                <td>
                                    <strong>{{ product.name }}</strong>
                                    <br>
                                    <span class="text-muted" style="font-size: 14px;">{{ product.brand }}</span>
                                </td>

                                <td class="text-muted" style="font-size: 14px;">
                                    {{ product.sku }}
                                </td>

                                <td class="center">
                                    <span class="{% if product.total_stock > 0 %}text-stock-green{% else %}text-stock-red{% endif %}">
                                        {{ product.total_stock }}
                                    </span>
                                </td>

                                <td class="center">
                                    <a href="#" class="{% if product.is_featured %}pill-featured{% else %}pill-not-featured{% endif %}">
                                        {% if product.is_featured %}★ FEATURED{% else %}☆ NOT FEATURED{% endif %}
                                    </a>
                                </td>

                                <td class="center">
                                    <div class="action-buttons">
                                        <!-- Updated link to point to the edit route -->
                                        <a href="{{ path('admin_products_edit', {'id': product.id}) }}" class="btn-edit">Edit</a>
                                        <a href="#" class="btn-delete" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Back to Dashboard -->
        <p style="margin-top: 32px;">
            <a href="{{ path('admin_dashboard') }}" class="text-green text-bold" style="text-decoration: none;">&larr; Back to Dashboard</a>
        </p>
        
    </div>
</div>
{% endblock %}