<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %} — SYNCRO LAB</title>
    <link rel="stylesheet" href="{{ asset('styles/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/utilities.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/sections.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/responsive.css') }}">

    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>

    {% include 'partials/header.html.twig' %}

    <main>
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/footer.html.twig' %}

    <script src="{{ asset('app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
